{
 "site": "x.com",
 "_about": "The action guard's pack for x.com (X and Grok; scripts/guard/guard.mjs). First draft 13 Nov 2026 from X's known operation names, for videos on the owner's REAL X account (Andy, 13 Nov 2026: real accounts, the guard blocks posting, payments and anything risky). X sends changes as GraphQL mutations (POST /i/api/graphql/<id>/<Operation>) and a few REST calls (/i/api/1.1/...). The owner's X is a real account, so every change not listed under 'changes' and asked for by the job is blocked (default deny). To be completed from logged runs (explore.mjs --learn).",
 "own_hosts": "(^|\\.)(x|twitter)\\.com$",
 "ignore": [
  {
   "label": "X's own analytics and client events",
   "path": "/(1\\.1/)?jot/|/client_event|/scribe|/i/api/1\\.1/live_pipeline/|/i/jot"
  },
  {
   "label": "analytics hosts",
   "host": "(^|\\.)(ads-api\\.x\\.com|analytics\\.x\\.com|t\\.co|google-analytics\\.com|doubleclick\\.net|sentry\\.io)$"
  }
 ],
 "reads": [],
 "read_requests": [],
 "dangerous": [
  {
   "category": "post",
   "reason": "posting, replying, quoting or reposting on X",
   "match": [
    {
     "op": "^(CreateTweet|CreateNoteTweet|CreateScheduledTweet|CreateDraftTweet|EditDraftTweet|CreateRetweet|DeleteRetweet|PinTweet|UnpinTweet|CreateCommunityNote.*|PostTweet.*)$",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "/i/api/1\\.1/statuses/(update|retweet)",
     "method": "POST"
    },
    {
     "path": "/i/api/2/tweets?(/|$)",
     "method": "POST"
    }
   ]
  },
  {
   "category": "engage",
   "reason": "liking, bookmarking, following, blocking or muting on X",
   "match": [
    {
     "op": "^(FavoriteTweet|UnfavoriteTweet|CreateBookmark|DeleteBookmark|ListAddMember|ListRemoveMember|CreateList|.*Follow.*|.*Block.*|.*Mute.*)$",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "/i/api/1\\.1/(friendships|blocks|mutes)/",
     "method": "POST"
    }
   ]
  },
  {
   "category": "dm",
   "reason": "sending or changing direct messages",
   "match": [
    {
     "path": "/i/api/1\\.1/dm/(new|new2|conversation)",
     "method": "POST"
    },
    {
     "op": "(DM|DirectMessage|SendMessage)",
     "kind": "mutation|server-action|persisted"
    }
   ]
  },
  {
   "category": "pay",
   "reason": "paying or subscribing (a real charge)",
   "match": [
    {
     "host": "(^|\\.)(stripe\\.com|stripe\\.network|paypal\\.com|apple\\.com|braintreegateway\\.com)$",
     "method": "POST"
    },
    {
     "op": "(Subscri|Checkout|Payment|Purchase|Billing|Order|Upgrade|Premium|Tip)",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "(subscri|checkout|payment|purchase|billing|premium)",
     "method": "POST|PUT|PATCH"
    }
   ]
  },
  {
   "category": "account",
   "reason": "changing the X account, its security or its profile",
   "match": [
    {
     "op": "(Profile|Password|TwoFactor|LoginVerification|Email|Phone|Username|Account|Deactivat|Settings|Verification|Backup)",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "/i/api/1\\.1/account/",
     "method": "POST"
    }
   ]
  },
  {
   "category": "delete",
   "reason": "deleting anything on X",
   "match": [
    {
     "op": "^Delete",
     "kind": "mutation|server-action|persisted"
    },
    {
     "method": "DELETE"
    }
   ]
  },
  {
   "category": "secret",
   "reason": "creating or revealing API keys or apps",
   "match": [
    {
     "host": "(^|\\.)developer\\.(x|twitter)\\.com$",
     "method": "POST|PUT|PATCH|DELETE"
    }
   ]
  }
 ],
 "changes": [
  {
   "id": "grok-message",
   "label": "asking Grok a question (a private Grok chat)",
   "asked_by": "\\bgrok\\b",
   "match": [
    {
     "path": "/i/api/2/grok/",
     "method": "POST"
    },
    {
     "op": "Grok",
     "kind": "mutation|server-action|persisted"
    }
   ]
  }
 ]
}