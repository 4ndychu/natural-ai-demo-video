{
 "site": "x.com",
 "_about": "The action guard's pack for x.com (X and Grok; scripts/guard/guard.mjs), for videos on the owner's REAL X account (@ecomchigga; Andy, 13 Nov 2026: real accounts, the guard blocks posting, payments and anything risky). First draft from X's operation names; ignore, reads and the Grok rules from logged runs on 13 Nov 2026 (output/guard-learn/x.com*, explore.mjs --learn: home, a profile, search, Grok, Premium sign-up). X sends changes as GraphQL mutations (POST /i/api/graphql/<id>/<Operation>) and REST calls (/i/api/1.1/...). Every change not listed under 'changes' and asked for by the job is blocked (default deny). X often sends an operation without its name in the body, so every operation rule is matched by its address too.",
 "own_hosts": "(^|\\.)(x|twitter)\\.com$",
 "ignore": [
  {
   "label": "X's own analytics, client events and error logs (log= bodies)",
   "path": "^/(i/api/)?1\\.1/(flow/(timeline|viewer)\\.json|graphql/(viewer_context|app_context)\\.json|promoted_content/log\\.json)$",
   "body": "(^|&)(log|event)="
  },
  {
   "label": "X's own analytics and client events",
   "path": "/(1\\.1/)?jot/|/client_event|/scribe|/i/jot"
  },
  {
   "label": "X's ad-click tracking and the page's own failed-script reports (seen logged out and on Cloudflare checks)",
   "method": "POST",
   "path": "^/i/(adsctp|script-load-failure)$"
  },
  {
   "label": "live counts on the posts in view (which posts to send like and repost counts for)",
   "path": "^/(i/api/)?1\\.1/live_pipeline/update_subscriptions$"
  },
  {
   "label": "the browser's own security reports",
   "path": "^/i/csp_report$"
  },
  {
   "label": "Cloudflare's bot check",
   "path": "^/cdn-cgi/challenge-platform/"
  },
  {
   "label": "this browser's notification permission, recorded per device",
   "method": "PUT",
   "path": "^/i/api/1\\.1/strato/column/None/[^/]+,pushNotifications/clients/permissionsState$"
  },
  {
   "label": "analytics hosts",
   "host": "(^|\\.)(ads-api\\.x\\.com|analytics\\.x\\.com|t\\.co|google-analytics\\.com|doubleclick\\.net|sentry\\.io)$"
  }
 ],
 "reads": [
  "^(HomeTimeline|HomeLatestTimeline|SearchTimeline|UserTweets|UserTweetsAndReplies|UserMedia|UserByScreenName|UserByRestId|TweetDetail|TweetResultByRestId|ExplorePage|GenericTimelineById)$"
 ],
 "read_requests": [
  {
   "label": "timelines, profiles, posts and search (reads sent by POST, named only in the address)",
   "method": "POST",
   "path": "^/i/api/graphql/[^/]+/(HomeTimeline|HomeLatestTimeline|SearchTimeline|UserTweets|UserTweetsAndReplies|UserMedia|UserByScreenName|UserByRestId|TweetDetail|TweetResultByRestId|ExplorePage|GenericTimelineById)$"
  }
 ],
 "dangerous": [
  {
   "category": "pay",
   "quiet": true,
   "reason": "X preparing a Premium checkout by itself on every page (refused; no charge; the video carries on)",
   "match": [
    {
     "host": "(^|\\.)grok\\.com$",
     "path": "PrePurchaseService/CreateCheckoutSession"
    }
   ]
  },
  {
   "category": "account",
   "reason": "linking the X account to a Grok account (an account change)",
   "match": [
    {
     "path": "(link|Link)",
     "host": "(^|\\.)(x\\.com|grok\\.com|x\\.ai)$",
     "method": "POST|PUT|PATCH"
    },
    {
     "op": "(Link|link).*(Account|account)|AccountLink",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/[^/?]*(?:(Link|link).*(Account|account)|AccountLink)[^/?]*$"
    }
   ]
  },
  {
   "category": "post",
   "reason": "posting, replying, quoting or reposting on X",
   "match": [
    {
     "op": "^(CreateTweet|CreateNoteTweet|CreateScheduledTweet|CreateDraftTweet|EditDraftTweet|CreateRetweet|DeleteRetweet|PinTweet|UnpinTweet|CreateCommunityNote.*|PostTweet.*)$",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/(?:(CreateTweet|CreateNoteTweet|CreateScheduledTweet|CreateDraftTweet|EditDraftTweet|CreateRetweet|DeleteRetweet|PinTweet|UnpinTweet|CreateCommunityNote.*|PostTweet.*))$"
    },
    {
     "path": "/i/api/1\\.1/statuses/(update|retweet)",
     "method": "POST"
    },
    {
     "path": "/i/api/2/tweets?(/|$)",
     "method": "POST"
    }
   ]
  },
  {
   "category": "engage",
   "reason": "liking, bookmarking, following, blocking or muting on X",
   "match": [
    {
     "op": "^(FavoriteTweet|UnfavoriteTweet|CreateBookmark|DeleteBookmark|ListAddMember|ListRemoveMember|CreateList|.*Follow.*|.*Block.*|.*Mute.*)$",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/(?:(FavoriteTweet|UnfavoriteTweet|CreateBookmark|DeleteBookmark|ListAddMember|ListRemoveMember|CreateList|.*Follow.*|.*Block.*|.*Mute.*))$"
    },
    {
     "path": "/i/api/1\\.1/(friendships|blocks|mutes)/",
     "method": "POST"
    }
   ]
  },
  {
   "category": "dm",
   "reason": "sending or changing direct messages",
   "match": [
    {
     "path": "/i/api/1\\.1/dm/(new|new2|conversation)",
     "method": "POST"
    },
    {
     "op": "(DM|DirectMessage|SendMessage)",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/[^/?]*(?:(DM|DirectMessage|SendMessage))[^/?]*$"
    }
   ]
  },
  {
   "category": "pay",
   "reason": "paying or subscribing (a real charge)",
   "match": [
    {
     "host": "(^|\\.)(stripe\\.com|stripe\\.network|paypal\\.com|apple\\.com|braintreegateway\\.com)$",
     "method": "POST"
    },
    {
     "op": "(Subscri|Checkout|Payment|Purchase|Billing|Order|Upgrade|Premium|Tip)",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/[^/?]*(?:(Subscri|Checkout|Payment|Purchase|Billing|Order|Upgrade|Premium|Tip))[^/?]*$"
    },
    {
     "path": "(subscri|checkout|payment|purchase|billing|premium)",
     "method": "POST|PUT|PATCH"
    }
   ]
  },
  {
   "category": "account",
   "reason": "changing the X account, its security or its profile",
   "match": [
    {
     "op": "(Profile|Password|TwoFactor|LoginVerification|Email|Phone|Username|Account|Deactivat|Settings|Verification|Backup)",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/[^/?]*(?:(Profile|Password|TwoFactor|LoginVerification|Email|Phone|Username|Account|Deactivat|Settings|Verification|Backup))[^/?]*$"
    },
    {
     "path": "/i/api/1\\.1/account/",
     "method": "POST"
    }
   ]
  },
  {
   "category": "delete",
   "reason": "deleting anything on X",
   "match": [
    {
     "op": "^Delete",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/(?:Delete)[^/?]*$"
    },
    {
     "method": "DELETE"
    }
   ]
  },
  {
   "category": "secret",
   "reason": "creating or revealing API keys or apps",
   "match": [
    {
     "host": "(^|\\.)developer\\.(x|twitter)\\.com$",
     "method": "POST|PUT|PATCH|DELETE"
    }
   ]
  }
 ],
 "changes": [
  {
   "id": "grok-message",
   "label": "asking Grok a question (a private Grok chat)",
   "asked_by": "\\bgrok\\b",
   "match": [
    {
     "path": "^/(i/api/)?2/grok/",
     "method": "POST",
     "host": "^(grok\\.)?x\\.com$|^api\\.x\\.com$"
    },
    {
     "op": "Grok",
     "kind": "mutation|server-action|persisted"
    },
    {
     "path": "^/i/api/graphql/[^/]+/[^/?]*(?:Grok)[^/?]*$"
    },
    {
     "host": "(^|\\.)grok\\.com$",
     "path": "^/rest/app-chat/conversations",
     "method": "POST"
    }
   ]
  },
  {
   "id": "grok-intro",
   "label": "closing Grok's intro box (\"Not now\": saves that its tips were seen)",
   "asked_by": "\\bgrok\\b",
   "match": [
    {
     "op": "^PutClientEducationFlag$"
    },
    {
     "path": "^/i/api/graphql/[^/]+/(?:PutClientEducationFlag)$"
    }
   ]
  }
 ]
}